APP_NAME="Subhan Portfolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Port used by `php artisan serve` (and the host:port Laravel prints).
SERVER_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

###############################################################################
# Portfolio content
#
# Everything below is optional. Personal details are hidden from the interface
# while they stay empty, so the site works fine without them. Fill in only the
# values that are genuinely yours.
###############################################################################

# Public contact details shown on the Contact page and in the footer.
PORTFOLIO_EMAIL=
PORTFOLIO_PHONE=
PORTFOLIO_LOCATION=

# Social profiles. Each link is only rendered when it has a value.
PORTFOLIO_GITHUB=
PORTFOLIO_LINKEDIN=
PORTFOLIO_X=

# Short availability line shown in the hero.
PORTFOLIO_AVAILABILITY="Available for new projects"

# Path to your photo, relative to the public/ directory.
PORTFOLIO_PHOTO="images/profile/profile-placeholder.svg"

# Where contact form notifications are sent. Leave empty to keep submissions in
# the database only. No email is ever claimed unless it was actually sent.
PORTFOLIO_NOTIFY_EMAIL=

# Currency symbol used for the contact form budget options.
PORTFOLIO_CURRENCY="$"

# -----------------------------------------------------------------------------
# Administrator dashboard
#
# The site is managed from /admin (sign in at /login). Content, including the
# projects above and the profile picture, is edited there and stored in the
# database, so nothing here needs changing after the first setup.
#
# Create the first administrator account with:
#   php artisan portfolio:make-admin you@example.com
# -----------------------------------------------------------------------------
